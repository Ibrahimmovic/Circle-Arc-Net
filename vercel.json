{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "circle-arc-net",
  "installCommand": "cd agora-forge && npm install",
  "buildCommand": "cd agora-forge && npm run build",
  "devCommand": "cd agora-forge && npm run dev",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://circle-arc-net.vercel.app"
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}
