# Circle — server-side (Wallets API). Never expose in the browser.
# Paste your Circle TEST_API_KEY (server-only)
CIRCLE_API_KEY=TEST_API_KEY:your_id:your_secret

# Circle KIT_KEY (Swap + estimates; also set in Vercel)
NEXT_PUBLIC_CIRCLE_KIT_KEY=KIT_KEY:your_id:your_secret

# Zerion — REQUIRED for submission-grade portfolio (txs, NFTs, icons, net worth)
ZERION_API_KEY=zk_your_key

# GoldRush / Covalent — balances + spam flags (works without Zerion via CoinGecko prices)
GOLDRUSH_API_KEY=cqt_your_key

# Moralis — multichain token balances + USD prices (fallback when Zerion rate-limits)
MORALIS_API_KEY=your_moralis_jwt_or_api_key

# Optional integrations (set on Vercel as needed — never commit real keys)
# ALCHEMY_API_KEY=
# GOPLUS_API_KEY=
# GOPLUS_API_SECRET=
# NEXT_PUBLIC_REOWN_PROJECT_ID=
# DUNE_API_KEY=

# Default network at first visit. Users can switch Mainnet/Testnet in the app header.
# Production: mainnet. Use testnet for Arc/CCTP hackathon demos.
NEXT_PUBLIC_NETWORK=mainnet
# Portfolio & dashboard APIs use ?network= from the toggle (both work on one deploy).

# Optional: demo wallet when user has not connected
NEXT_PUBLIC_DEMO_WALLET=0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045

# Production (Vercel)
NEXT_PUBLIC_APP_URL=https://circle-arc-net.vercel.app
