# Circle — server-side (Wallets API). Never expose in the browser.
CIRCLE_API_KEY=TEST_API_KEY:your_id:your_secret

# Circle KIT_KEY (Swap + estimates; also set in Vercel)
NEXT_PUBLIC_CIRCLE_KIT_KEY=KIT_KEY:your_id:your_secret

# ── Portfolio stack (testnet + mainnet) ─────────────────────────────────────
# Balances
ZERION_API_KEY=zk_your_key

# Transaction history (Alchemy Transfers API)
ALCHEMY_API_KEY=your_alchemy_key

# Scam detection (GoPlus token security)
GOPLUS_API_KEY=your_goplus_app_key
GOPLUS_API_SECRET=your_goplus_app_secret

# Prices (CoinGecko public API — no key required)
# COINGECKO_API_KEY=optional_pro_key

# Analytics (Dune query execution)
DUNE_API_KEY=your_dune_key
# Optional: custom Dune query id with ?wallet= parameter
# DUNE_PORTFOLIO_QUERY_ID=1234567

# Backup wallet data (Covalent / GoldRush)
GOLDRUSH_API_KEY=cqt_your_key

# Optional fallback indexer (not in primary matrix)
# MORALIS_API_KEY=

# WalletConnect / Reown (browser)
# NEXT_PUBLIC_REOWN_PROJECT_ID=

# Default network at first visit. Users can switch Mainnet/Testnet in the app header.
NEXT_PUBLIC_NETWORK=mainnet

# Optional: demo wallet when user has not connected
NEXT_PUBLIC_DEMO_WALLET=0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045

# Production (Vercel)
NEXT_PUBLIC_APP_URL=https://circle-arc-net.vercel.app
